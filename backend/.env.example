# ==============================================================================
# Scaliify Backend API Environment Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Server Environment Variables
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for CORS (e.g., https://your-production-app.vercel.app)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection URL (e.g. Neon, Supabase, Railway, AWS RDS)
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Resend Email Notification Service
RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_EMAIL=sarah@scaliify.com
RESEND_FROM_EMAIL=Scaliify Notifications <notifications@scaliify.com>

