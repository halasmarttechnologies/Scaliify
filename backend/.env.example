# ==============================================================================
# Scaliify Backend API Environment Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Server Environment Variables
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for CORS (e.g., https://your-production-app.vercel.app)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection URL (e.g. Neon, Supabase, Railway, AWS RDS)
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Upstash Redis Distributed Rate Limiting & Response Caching
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

