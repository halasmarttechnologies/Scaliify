# ==============================================================================
# Scaliify Next.js Frontend Environment Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# ── Backend URL (SERVER-SIDE ONLY) ─────────────────────────────────────────────
# Used by the /api/proxy/* Next.js Route Handlers only.
# NO "NEXT_PUBLIC_" prefix — this value is NEVER bundled into client JavaScript
# and will NOT be visible in browser DevTools or source maps.
BACKEND_URL=http://localhost:5000

# ── Upstash Redis (Optional — server-side only) ────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# ── Resend Email Configuration (Optional — fallback for serverless/proxy) ──────
RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_EMAIL=info@scaliify.com
RESEND_FROM_EMAIL=Scaliify Notifications <notifications@scaliify.com>
