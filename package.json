{
  "name": "scaliify-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Scaliify HR Consultancy & HR Technology Platform Monorepo",
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,green\" \"npm run dev:backend\" \"npm run dev:frontend\",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend && npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "lint:frontend": "npm run lint --prefix frontend",
    "db:generate": "npm run db:generate --prefix backend",
    "db:push": "npm run db:push --prefix backend",
    "db:studio": "npm run db:studio --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "test": "npm run test --prefix frontend",
    "test:watch": "npm run test:watch --prefix frontend",
    "test:backend": "npm run test --prefix backend",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "test:e2e:ui": "npm run test:e2e:ui --prefix frontend",
    "test:security": "npm run test:security --prefix backend",
    "test:all": "npm run test --prefix frontend && npm run test --prefix backend && npm run test:security --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
