# ==============================================================================
# Scaliify Root Environment Variables Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for CORS
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://username:password@localhost:5432/scaliify_db

# Frontend Public API URL (Accessible by browser)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Email Notification Service (Resend)
RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_EMAIL=sarah@scaliify.com
RESEND_FROM_EMAIL=Scaliify Notifications <notifications@scaliify.com>

